import glob

from lsff_utils import paths, snakemake_utils

debug = config["debug"]
local = config["local"]
full_scale = config["full_scale"]

# Recipes are plain strings and Snakemake does the interpolation -- never
# f-strings. See "Recipes are not f-strings" in the root Snakefile. Anything a
# recipe needs that has to be computed in Python is named here instead, so the
# recipe can reference it as `{name}`; anything that has to be computed from the
# wildcards goes in the rule's `params`, which is the only interpolation
# Snakemake resolves per job.
artifact_setup = config["artifact_env_setup"]
simulation_setup = config["simulation_env_setup"]
artifact_debug = "--pdb -vvv" if debug else ""
psimulate_debug = "--pdb -vvv" if debug and not local else ""
cluster_args = "" if debug or local else "-P proj_simscience -m 2 -r 01:00:00 -q all.q"
# `simulate` in debug (one process, in the foreground), `psimulate` otherwise,
# and `local_psimulate.py` when a run is kept off the cluster entirely.
simulate_command = (
    ("python ../local_" if local else "")
    + ("p" if not debug else "")
    + "simulate"
    + (".py" if local else " run")
)
# debug runs a single branch, so it takes no branch configuration at all.
branches_file = (
    "src/vivarium_gates_lsff_2026_maternal/model_specifications/branches/scenarios"
    + ("_small" if not full_scale else "")
    + ".yaml"
)
branches_arg = "" if debug else branches_file

# Artifacts and simulation output live on the team drive under the current model
# iteration, not in the repository -- see lsff_utils.paths. Both are named here
# from the constants so that bumping MODEL_NUMBER repoints these rules too.
MATERNAL_ARTIFACT = str(paths.MATERNAL_ARTIFACT_ROOT / "{vehicle}" / "{location}.hdf")
MATERNAL_RUN_MARKER = snakemake_utils.run_marker(
    paths.MATERNAL_RESULTS_ROOT, "{location}", "{vehicle}"
)

data_inputs = [
    f"0100_data_prep/results/{item}/{{location}}.csv"
    for item in [
        "iron/{vehicle}/baseline_fortification/any_coverage",
        "iron/{vehicle}/baseline_fortification/full_coverage",
        "iron/{vehicle}/baseline_fortification/partial_coverage_amount/mean",
        "iron/{vehicle}/baseline_fortification/partial_coverage_amount/sd",
        "iron/{vehicle}/baseline_fortification/concentration",
        "{vehicle}/vehicle_consumption/any",
        "{vehicle}/vehicle_consumption/fortifiability",
        "{vehicle}/vehicle_consumption/amount/mean",
        "{vehicle}/vehicle_consumption/amount/sd",
        "iron/{vehicle}/intervention/intervention_fortification/any_coverage",
        "iron/{vehicle}/intervention/intervention_fortification/effectiveness",
        "iron/{vehicle}/intervention/intervention_fortification/concentration",
        "maternal_disorders_incidence_disparities",
        "hemoglobin/mean_disparities",
        "hemoglobin/sd_disparities",
        "wealth_quintile_probabilities",
        "pregnancy/incidence",
    ]
] + [f"0100_data_prep/results/iron/fortification_hemoglobin_effects.csv"]

rule pregnancy_artifacts:
    input: ["0200_pregnancy_sim/src/vivarium_gates_lsff_2026_maternal/data/loader.py"] + data_inputs
    output: [MATERNAL_ARTIFACT]
    shell:
        """
        {artifact_setup}
        rm -f {output}
        make_artifacts -p maternal -o {paths.MATERNAL_ARTIFACT_ROOT}/{wildcards.vehicle} -l {wildcards.location} --vehicle {wildcards.vehicle} -a --mean {artifact_debug}
        """

code_inputs = glob.glob("0200_pregnancy_sim/src/vivarium_gates_lsff_2026_maternal/**/*.py", recursive=True)

rule pregnancy_simulations:
    input:
        [
            MATERNAL_ARTIFACT,
            "0200_pregnancy_sim/src/vivarium_gates_lsff_2026_maternal/model_specifications/model_spec.yaml",
            "0200_pregnancy_sim/" + branches_file,
        ] + code_inputs + data_inputs
    # psimulate names its own output directory after the artifact and the launch
    # time, so the rule is tracked by the marker naming the run it produced
    # rather than by parquet paths Snakemake cannot predict. Previous runs are
    # left in place; a rerun adds a run instead of overwriting the one a set of
    # validated results was built from.
    output: [MATERNAL_RUN_MARKER]
    params:
        write_marker=lambda wildcards: snakemake_utils.write_run_marker(
            paths.MATERNAL_RESULTS_ROOT, wildcards.location, wildcards.vehicle
        ),
    shell:
        """
        {simulation_setup}
        cd 0200_pregnancy_sim
        rm -f dump.rdb
        {simulate_command} src/vivarium_gates_lsff_2026_maternal/model_specifications/model_spec.yaml {branches_arg} -i {paths.MATERNAL_ARTIFACT_ROOT}/{wildcards.vehicle}/{wildcards.location}.hdf -o {paths.MATERNAL_RESULTS_ROOT}/{wildcards.vehicle} {cluster_args} {psimulate_debug}
        rm -f dump.rdb
        {params.write_marker}
        """
