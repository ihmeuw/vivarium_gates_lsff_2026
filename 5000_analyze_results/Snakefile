from lsff_utils import config_utils, paths, snakemake_utils

debug = config["debug"]

# Recipes are plain strings and Snakemake does the interpolation -- never
# f-strings. See "Recipes are not f-strings" in the root Snakefile.
artifact_setup = config["artifact_env_setup"]
papermill_engine = "--engine debug" if debug else ""

# Simulation output lives on the team drive in per-run, timestamp-named
# directories, so these rules depend on the markers naming the runs rather than
# on parquet paths. The notebooks resolve the same runs through
# lsff_utils.paths.latest_results, which keeps the Snakefile and the notebooks
# from having to agree on a layout twice over.
MATERNAL_RUN_MARKER = snakemake_utils.run_marker(
    paths.MATERNAL_RESULTS_ROOT, "{location}", "{vehicle}"
)
CHILD_RUN_MARKER = snakemake_utils.run_marker(
    paths.CHILD_RESULTS_ROOT, "{location}", "{vehicle}"
)

pregnancy_results_of_interest = ["pregnancy_outcome_count", "ylds", "ylls", "person_time_anemia", "transition_count_maternal_disorders"]
rescaled_pregnancy_results = [
    f"5000_analyze_results/results/rescaled_pregnancy_results/{{vehicle}}/{{location}}/{result}.parquet"
    for result in pregnancy_results_of_interest
]

rule rescale_pregnancy_results:
    input:
        [
            "5000_analyze_results/0100_rescale_results/pregnancy_results.ipynb",
            MATERNAL_RUN_MARKER,
        ]
    output:
        rescaled_pregnancy_results
    log: "5000_analyze_results/executed/{location}/{vehicle}/0100_rescale_results/pregnancy_results.ipynb"
    shell:
        """
        {artifact_setup}
        cd 5000_analyze_results/0100_rescale_results
        mkdir -p ../executed/{wildcards.location}/{wildcards.vehicle}/0100_rescale_results/
        papermill pregnancy_results.ipynb ../executed/{wildcards.location}/{wildcards.vehicle}/0100_rescale_results/pregnancy_results.ipynb -p location {wildcards.location} -p vehicle {wildcards.vehicle} -k python3 {papermill_engine}
        """

child_results_of_interest = ["deaths", "ylds", "ylls"]
rescaled_child_results = [
    f"5000_analyze_results/results/rescaled_child_results/{{vehicle}}/{{location}}/{result}.parquet"
    for result in child_results_of_interest
]

rule rescale_child_results:
    input:
        # The child rescaling divides through by pregnancy outcome counts, so it
        # reads the maternal run as well as the child one.
        [
            "5000_analyze_results/0100_rescale_results/child_results.ipynb",
            CHILD_RUN_MARKER,
            MATERNAL_RUN_MARKER,
        ]
    output:
        rescaled_child_results
    log: "5000_analyze_results/executed/{location}/{vehicle}/0100_rescale_results/child_results.ipynb"
    shell:
        """
        {artifact_setup}
        cd 5000_analyze_results/0100_rescale_results
        mkdir -p ../executed/{wildcards.location}/{wildcards.vehicle}/0100_rescale_results/
        papermill child_results.ipynb ../executed/{wildcards.location}/{wildcards.vehicle}/0100_rescale_results/child_results.ipynb -p location {wildcards.location} -p vehicle {wildcards.vehicle} -k python3 {papermill_engine}
        """

# An arm with no iron pathway of its own (ethiopia/salt) has no rescaled results,
# so cases_by_scenario and dalys_by_scenario read rice/india's as an all-zero
# template. Declared here because that dependency is invisible to Snakemake:
# without it a forced rebuild can run the folate-only arm before rice/india's
# rescaling has finished, and the notebook fails on the missing template.
TEMPLATE_WILDCARDS = {"location": "india", "vehicle": "rice"}
template_rescaled_results = [
    path.format(**TEMPLATE_WILDCARDS)
    for path in rescaled_pregnancy_results + rescaled_child_results
]


def dalys_by_scenario_inputs(wildcards):
    fortificants = config_utils.get_location_fortificant_vehicle_intervention_scenarios().pipe(lambda df: df[df.location == wildcards.location]).fortificant.unique()
    result = ["5000_analyze_results/dalys_by_scenario.ipynb"]
    if "folate" in fortificants:
        result += [
            "0500_neural_tube_defects_model/results/{location}/{vehicle}/ylls_by_scenario.csv",
        ]
    if "iron" in fortificants:
        result += rescaled_pregnancy_results + rescaled_child_results + [
            "0400_non_pregnant_anemia_model/results/{vehicle}/{location}/ylds.parquet",
        ]
    else:
        result += [
            "0400_non_pregnant_anemia_model/results/{vehicle}/{location}/ylds.parquet",
        ] + template_rescaled_results
    return result

rule dalys_by_scenario:
    input: dalys_by_scenario_inputs
    output: "5000_analyze_results/results/{location}/{vehicle}/dalys_by_scenario.csv"
    log: "5000_analyze_results/executed/{location}/{vehicle}/dalys_by_scenario.ipynb"
    shell:
        """
        {artifact_setup}
        cd 5000_analyze_results
        mkdir -p ./executed/{wildcards.location}/{wildcards.vehicle}
        papermill dalys_by_scenario.ipynb ./executed/{wildcards.location}/{wildcards.vehicle}/dalys_by_scenario.ipynb -p location {wildcards.location} -p vehicle {wildcards.vehicle} -k python3 {papermill_engine}
        """

def cases_by_scenario_inputs(wildcards):
    fortificants = config_utils.get_location_fortificant_vehicle_intervention_scenarios().pipe(lambda df: df[df.location == wildcards.location]).fortificant.unique()
    result = ["5000_analyze_results/cases_by_scenario.ipynb"]
    if "folate" in fortificants:
        result += [
            "0500_neural_tube_defects_model/results/{location}/{vehicle}/ntd_cases_by_scenario.csv",
        ]
    iron_paths = rescaled_pregnancy_results + rescaled_child_results + [
        "0400_non_pregnant_anemia_model/results/{vehicle}/{location}/anemia_cases.parquet",
        "0400_non_pregnant_anemia_model/results/{vehicle}/{location}/anemia_prevalence.parquet",
    ]
    if "iron" in fortificants:
        result += iron_paths
    else:
        result += [
            "0400_non_pregnant_anemia_model/results/{vehicle}/{location}/anemia_cases.parquet",
            "0400_non_pregnant_anemia_model/results/{vehicle}/{location}/anemia_prevalence.parquet",
        ] + template_rescaled_results
    return result

cases_by_scenario_outputs = [
    "pregnant_anemia_prevalence_by_scenario.csv",
    "maternal_disorders_incident_cases_by_scenario.csv",
    "neonatal_deaths_by_scenario.csv",
    "prevalent_anemia_cases_by_scenario.csv",
    "ntd_cases_by_scenario.csv",
]

rule cases_by_scenario:
    input: cases_by_scenario_inputs
    output: [f"5000_analyze_results/results/{{location}}/{{vehicle}}/{output}" for output in cases_by_scenario_outputs]
    log: "5000_analyze_results/executed/{location}/{vehicle}/cases_by_scenario.ipynb"
    shell:
        """
        {artifact_setup}
        cd 5000_analyze_results
        mkdir -p ./executed/{wildcards.location}/{wildcards.vehicle}/
        papermill cases_by_scenario.ipynb ./executed/{wildcards.location}/{wildcards.vehicle}/cases_by_scenario.ipynb -p location {wildcards.location} -p vehicle {wildcards.vehicle} -k python3 {papermill_engine}
        """

dalys_by_scenario_resolved = []
cases_by_scenario_resolved = []

for (location, vehicle) in config_utils.get_configured_combos(["location", "vehicle"]):
    dalys_by_scenario_resolved.append(f"5000_analyze_results/results/{location}/{vehicle}/dalys_by_scenario.csv")
    cases_by_scenario_resolved += [
        f"5000_analyze_results/results/{location}/{vehicle}/{output}" for output in cases_by_scenario_outputs
    ]

rule results_spreadsheet:
    input:
        ["5000_analyze_results/results_spreadsheet.ipynb"] +
        dalys_by_scenario_resolved +
        cases_by_scenario_resolved
    output: "5000_analyze_results/results_spreadsheet.xlsx"
    log: "5000_analyze_results/executed/results_spreadsheet.ipynb"
    shell:
        """
        {artifact_setup}
        cd 5000_analyze_results
        mkdir -p ./executed/
        papermill results_spreadsheet.ipynb ./executed/results_spreadsheet.ipynb -k python3 {papermill_engine}
        """

rule results_plots:
    input:
        ["5000_analyze_results/results_plots.ipynb"] +
        dalys_by_scenario_resolved +
        cases_by_scenario_resolved
    log: "5000_analyze_results/executed/results_plots.ipynb"
    shell:
        """
        {artifact_setup}
        cd 5000_analyze_results
        mkdir -p ./executed/
        papermill results_plots.ipynb ./executed/results_plots.ipynb -k python3 {papermill_engine}
        """
