from snakemake.io import directory

import os

use_psimulate = not "NO_PSIMULATE" in os.environ

rule pregnancy_artifact_building_venv:
    input: ["0200_pregnancy_sim/artifact_building_pip_lock.txt"]
    output: [directory("0200_pregnancy_sim/artifact_building"), "0200_pregnancy_sim/artifact_building/bin/activate"]
    shell:
        f"""
        cd 0200_pregnancy_sim
        rm -rf artifact_building
        python -m venv artifact_building
        source artifact_building/bin/activate
        pip install -r artifact_building_pip_lock.txt
        pip install -e .[data]
        """

rule pregnancy_simulation_running_venv:
    input: ["0200_pregnancy_sim/simulation_running_pip_lock.txt"]
    output: [directory("0200_pregnancy_sim/simulation_running"), "0200_pregnancy_sim/simulation_running/bin/activate"]
    shell:
        f"""
        cd 0200_pregnancy_sim
        rm -rf simulation_running
        python -m venv simulation_running
        source simulation_running/bin/activate
        pip install -r simulation_running_pip_lock.txt
        pip install -e .[dev]
        """

rule pregnancy_artifacts:
    input: ["0200_pregnancy_sim/artifact_building/bin/activate", "0200_pregnancy_sim/src/vivarium_gates_lsff_by_wealth_quintile/data/loader.py"]
    output: ["0200_pregnancy_sim/artifacts/{location}.hdf"]
    shell:
        f"""
        cd 0200_pregnancy_sim
        source artifact_building/bin/activate
        rm -f artifacts/{{wildcards.location}}.hdf
        make_artifacts -vvv -o ./artifacts -l {{wildcards.location}} -a
        """

rule pregnancy_mean_draw_artifacts:
    input: ["0200_pregnancy_sim/artifacts/{location}.hdf", "convert_artifact_to_mean_draw.py"]
    output: ["0200_pregnancy_sim/mean_draw_artifacts/{location}.hdf"]
    shell:
        f"""
        cd 0200_pregnancy_sim
        source artifact_building/bin/activate
        rm -f mean_draw_artifacts/{{wildcards.location}}.hdf
        python ../convert_artifact_to_mean_draw.py artifacts/{{wildcards.location}}.hdf mean_draw_artifacts/{{wildcards.location}}.hdf
        """

import glob

code_inputs = glob.glob("0200_pregnancy_sim/src/vivarium_gates_lsff_by_wealth_quintile/**/*.py")
data_inputs = glob.glob("0200_pregnancy_sim/src/vivarium_gates_lsff_by_wealth_quintile/**/*.csv")

rule pregnancy_simulations:
    input:
        [
            "0200_pregnancy_sim/simulation_running/bin/activate",
            "0200_pregnancy_sim/mean_draw_artifacts/{location}.hdf",
            "0200_pregnancy_sim/src/vivarium_gates_lsff_by_wealth_quintile/model_specifications/model_spec.yaml",
            "0200_pregnancy_sim/src/vivarium_gates_lsff_by_wealth_quintile/model_specifications/branches/scenarios.yaml",
        ] + code_inputs + data_inputs
    output: [
        "0200_pregnancy_sim/sim_results/{location}/births.parquet",
        "0200_pregnancy_sim/sim_results/{location}/deaths.parquet",
        "0200_pregnancy_sim/sim_results/{location}/ylds.parquet",
        "0200_pregnancy_sim/sim_results/{location}/dalys.parquet",
    ]
    shell:
        f"""
        cd 0200_pregnancy_sim
        rm -rf sim_results/{{wildcards.location}} || true
        sleep 5
        rm -rf sim_results/{{wildcards.location}}
        source simulation_running/bin/activate
        rm -f dump.rdb
        {'p' if use_psimulate else ''}simulate run src/vivarium_gates_lsff_by_wealth_quintile/model_specifications/model_spec.yaml {'src/vivarium_gates_lsff_by_wealth_quintile/model_specifications/branches/scenarios.yaml' if use_psimulate else ''} -i mean_draw_artifacts/{{wildcards.location}}.hdf -o sim_results/ {'-P proj_simscience' if use_psimulate else ''} -vvv -q long.q
        mv sim_results/{{wildcards.location}}/*/results/*.parquet sim_results/{{wildcards.location}}
        """