from lsff_utils import config_utils, snakemake_utils
from snakemake.io import directory, touch

debug = config["debug"]

# Recipes are plain strings and Snakemake does the interpolation -- never
# f-strings. See "Recipes are not f-strings" in the root Snakefile. Anything a
# recipe needs that has to be computed in Python is named here instead, so the
# recipe can reference it as `{name}`.
artifact_setup = config["artifact_env_setup"]
papermill_engine = "--engine debug" if debug else ""

# When a run opts out of data prep, every input here is marked `ancient()` so
# that nothing in this stage reruns over a timestamp. Outputs that are actually
# missing are still built. See `snakemake_utils.freeze`.
frozen = config["skip_data_prep"]
common_setup = artifact_setup + "\ncd 0100_data_prep"

rule dhs_common:
    input:
        snakemake_utils.freeze([
            "0100_data_prep/dhs/common.ipynb",
        ], frozen)
    log: "0100_data_prep/executed/dhs/{location}/common.ipynb"
    output: 
        [
            "0100_data_prep/results/hemoglobin/mean_disparities/{location}.csv",
            "0100_data_prep/results/hemoglobin/sd_disparities/{location}.csv",
            "0100_data_prep/results/wealth_quintile_probabilities/{location}.csv",
            "0100_data_prep/results/birth_weight_disparities/{location}.csv",
        ]
    shell:
        """
        {common_setup}
        cd dhs
        mkdir -p ../executed/dhs/{wildcards.location}/
        papermill common.ipynb ../executed/dhs/{wildcards.location}/common.ipynb -k python3 -p location {wildcards.location} {papermill_engine}
        """

rule dhs_mm:
    input:
        snakemake_utils.freeze([
            "0100_data_prep/dhs/maternal_mortality_{location}.ipynb",
        ], frozen)
    log: "0100_data_prep/executed/dhs/{location}/maternal_mortality_{location}.ipynb"
    output: 
        [
            "0100_data_prep/results/maternal_disorders_incidence_disparities/{location}.csv",
        ]
    shell:
        """
        {common_setup}
        cd dhs
        mkdir -p ../executed/dhs/{wildcards.location}/
        papermill maternal_mortality_{wildcards.location}.ipynb ../executed/dhs/{wildcards.location}/maternal_mortality_{wildcards.location}.ipynb -k python3 {papermill_engine}
        """

# The extraction tables the data prep notebooks read (extraction/generated/) are built from
# the base tables, the literature and GF snapshots, decisions.csv and the model's list of
# arms, by extraction/integration/build_extraction.py. Snakemake does NOT run the build: it
# only checks that the committed tables are up to date, and stops if they aren't. Run the
# build by hand, review what changed and commit it (see 0100_data_prep/extraction/README.md).
# That way a failed build can't delete the committed tables, and the model only ever runs
# on tables someone has reviewed. tests/test_extraction_build.py runs the same check.
#
# The check joins the DAG only when data prep runs: with skip_data_prep=true, a missing
# check marker would otherwise make data prep rerun.
extraction_check_marker = "0100_data_prep/extraction/integration/.extraction_checked"
extraction_check = [] if frozen else [extraction_check_marker]

rule check_extraction:
    input:
        [
            f"0100_data_prep/extraction/{layer}/{table}.csv"
            for layer in ["data", "generated"]
            for table in ["country_vehicle", "country_vehicle_fortificant", "scenario_definition", "vehicle"]
        ] + [
            "0100_data_prep/extraction/integration/lit_long.csv",
            "0100_data_prep/extraction/integration/gf_long.csv",
            "0050_config/location_fortificant_vehicles.csv",
            "0100_data_prep/extraction/integration/decisions.csv",
            "0100_data_prep/extraction/integration/build_extraction.py",
            "0100_data_prep/extraction/integration/common.py",
            "0100_data_prep/extraction/integration/report.py",
        ]
    output:
        touch(extraction_check_marker)
    shell:
        """
        {common_setup}
        cd extraction/integration
        python build_extraction.py --check
        """

rule prep_vehicle:
    input:
        snakemake_utils.freeze([
            "0100_data_prep/extraction/prep_vehicle.ipynb",
            "0100_data_prep/extraction/generated/vehicle.csv",
        ], frozen) + extraction_check
    log: "0100_data_prep/executed/extraction/prep_vehicle.ipynb"
    output: 
        [
            "0100_data_prep/results/iron/fortification_hemoglobin_effects.csv",
            "0100_data_prep/results/iron/fortification_birthweight_effects.csv",
        ]
    shell:
        """
        {common_setup}
        cd extraction
        mkdir -p ../executed/extraction/
        papermill prep_vehicle.ipynb ../executed/extraction/prep_vehicle.ipynb -k python3 {papermill_engine}
        """

vehicle_specific_data_needs = [
    "vehicle_consumption/any",
    "vehicle_consumption/fortifiability",
    "vehicle_consumption/amount/mean",
    "vehicle_consumption/amount/sd",
]

location_vehicle_fortificant_specific_data_needs = [
    "baseline_fortification/any_coverage",
    "baseline_fortification/full_coverage",
    "baseline_fortification/effectiveness",
    "baseline_fortification/partial_coverage_amount/mean",
    "baseline_fortification/partial_coverage_amount/sd",
    "baseline_fortification/concentration",
]

location_vehicle_fortificant_intervention_scenario_specific_data_needs = [
    "intervention_fortification/any_coverage",
    "intervention_fortification/effectiveness",
    "intervention_fortification/concentration",
]

extracted_output_files = []
hces_output_files = []
# Written by the HCES notebook into hces/ (committed) and read by prep_extracted
hces_local_files = [
    "0100_data_prep/hces/india_non_government_rice_proportion_purchased.csv",
    "0100_data_prep/hces/india_proportion_government_rice.csv",
    "0100_data_prep/hces/india_share_eating_any_government_rice.csv",
    "0100_data_prep/hces/india_share_eating_only_government_rice.csv",
]

location_fortificant_vehicle_scenarios = config["location_fortificant_vehicle_scenarios"]

# HCES microdata covers India rice only; every other arm comes from the workbook.
for (location, vehicle) in config_utils.get_configured_combos(["location", "vehicle"]):
    for data_need in vehicle_specific_data_needs:
        file_name = f"0100_data_prep/results/{vehicle}/{data_need}/{location}.csv"
        if (location, vehicle) == ("india", "rice") and ("vehicle_consumption" in data_need) and data_need != "vehicle_consumption/fortifiability":
            hces_output_files.append(file_name)
        else:
            extracted_output_files.append(file_name)

for (location, vehicle, fortificant) in config_utils.get_configured_combos(["location", "vehicle", "fortificant"]):
    for data_need in location_vehicle_fortificant_specific_data_needs:
        file_name = f"0100_data_prep/results/{fortificant}/{vehicle}/{data_need}/{location}.csv"
        # India rice: HCES gives the partial-coverage amounts directly; any/full coverage are
        # the HCES PDS shares scaled in prep_extracted by the share of PDS rice fortified.
        if (location, vehicle) == ("india", "rice") and "partial_coverage_amount" in data_need:
            hces_output_files.append(file_name)
        else:
            extracted_output_files.append(file_name)

for (location, vehicle, fortificant, intervention_scenario) in config_utils.get_configured_combos(["location", "vehicle", "fortificant", "intervention_scenario"]):
    for data_need in location_vehicle_fortificant_intervention_scenario_specific_data_needs:
        file_name = f"0100_data_prep/results/{fortificant}/{vehicle}/{intervention_scenario}/{data_need}/{location}.csv"
        extracted_output_files.append(file_name)


rule prep_hces:
    input:
        snakemake_utils.freeze([
            "0100_data_prep/hces/01_extract_hces.ipynb",
        ], frozen)
    log: "0100_data_prep/executed/hces/01_extract_hces.ipynb"
    output: 
        hces_output_files + hces_local_files
    shell:
        """
        {common_setup}
        cd hces
        mkdir -p ../executed/hces/
        papermill 01_extract_hces.ipynb ../executed/hces/01_extract_hces.ipynb -k python3 {papermill_engine}
        """

rule prep_extracted:
    input:
        snakemake_utils.freeze([
            "0100_data_prep/extraction/prep_extracted.ipynb",
            "0100_data_prep/extraction/generated/country_vehicle.csv",
            "0100_data_prep/extraction/generated/country_vehicle_fortificant.csv",
            "0100_data_prep/extraction/generated/scenario_definition.csv",
            '0100_data_prep/results/wealth_quintile_probabilities/nigeria.csv',
        ] + hces_local_files, frozen) + extraction_check
    log: "0100_data_prep/executed/extraction/prep_extracted.ipynb"
    output: 
        extracted_output_files
    shell:
        """
        {common_setup}
        cd extraction
        mkdir -p ../executed/extraction/
        papermill prep_extracted.ipynb ../executed/extraction/prep_extracted.ipynb -k python3 {papermill_engine}
        """

# for location in locations:
#     output_files = [
#         f"0100_data_prep/results/{{fortificant}}/effective_baseline_coverage/{location}.csv",
#     ] + [
#         f"0100_data_prep/results/{{fortificant}}/{scenario}/effective_intervention_coverage/{location}.csv"
#         for scenario in scenarios[location]
#     ]

# One rule per configured (location, vehicle), because a rule's outputs can't
# depend on a wildcard and each pair has its own intervention scenarios.
# Location and vehicle reach the recipe through params: a loop variable named
# in a shell string would be read when the job runs, after the loop has ended.
for coverage_location, coverage_vehicle in config_utils.get_configured_combos(["location", "vehicle"]):
    rule:
        name: f"calculate_effective_coverage_{coverage_location}_{coverage_vehicle}"
        input:
            snakemake_utils.freeze([
                "0100_data_prep/coverage_calculation/calculate_effective_coverage_by_quintile_and_scenario.ipynb",
                f"0100_data_prep/results/wealth_quintile_probabilities/{coverage_location}.csv",
            ] + hces_output_files + extracted_output_files, frozen)
        log: f"0100_data_prep/executed/coverage_calculation/{{fortificant}}/{coverage_vehicle}/{coverage_location}/calculate_effective_coverage_by_quintile_and_scenario.ipynb"
        output:
            [
                f"0100_data_prep/results/{{fortificant}}/{coverage_vehicle}/baseline_fortification/effective_coverage/{coverage_location}.csv",
            ] + [
                f"0100_data_prep/results/{{fortificant}}/{coverage_vehicle}/{intervention_scenario}/intervention_fortification/effective_coverage/{coverage_location}.csv"
                for intervention_scenario in config_utils.get_intervention_scenarios(coverage_location, coverage_vehicle, config)
            ]
        params:
            location=coverage_location,
            vehicle=coverage_vehicle,
        shell:
            """
            {common_setup}
            cd coverage_calculation
            mkdir -p ../executed/coverage_calculation/{wildcards.fortificant}/{params.vehicle}/{params.location}/
            papermill calculate_effective_coverage_by_quintile_and_scenario.ipynb ../executed/coverage_calculation/{wildcards.fortificant}/{params.vehicle}/{params.location}/calculate_effective_coverage_by_quintile_and_scenario.ipynb -k python3 -p location {params.location} -p fortificant {wildcards.fortificant} -p vehicle {params.vehicle} {papermill_engine}
            """

rule population_with_pregnancy_status:
    input: snakemake_utils.freeze(["0100_data_prep/population/population_with_pregnancy_status.ipynb", "0100_data_prep/results/wealth_quintile_probabilities/{location}.csv"], frozen)
    log: f"0100_data_prep/executed/population/{{location}}/population_with_pregnancy_status.ipynb"
    output:
        [
            "0100_data_prep/results/population/total/{location}.csv",
            "0100_data_prep/results/population/stratified/{location}.csv",
            "0100_data_prep/results/pregnancy/incidence/{location}.csv",
            "0100_data_prep/results/pregnancy/prevalence/{location}.csv",
        ]
    shell:
        """
        {common_setup}
        cd population
        mkdir -p ../executed/population/{wildcards.location}/
        papermill population_with_pregnancy_status.ipynb ../executed/population/{wildcards.location}/population_with_pregnancy_status.ipynb -k python3 -p location {wildcards.location} {papermill_engine}
        """
